#!/usr/bin/env bash
# flakesmith pre-commit gate — mechanical CI gate over the packages a commit touches.
#
# Why a hook: a rule that lives only on paper has no enforcement; CI is too
# far away to keep each commit honest.
# Why not the full suite: `go test -race ./...` takes ~3 min and the cli
# package spawns real `go test` subprocesses, so it stretches on a busy
# machine. The full suite is CI's job; the gate here exists to keep the commit
# within seconds.
#
# Scope: the packages the staged diff TOUCHES. If go.mod / Makefile / workflow
# was touched, the scope becomes the whole repo.
#
# No exceptions: --no-verify is not an accepted escape hatch.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

red=$'\033[31m'; off=$'\033[0m'
fail() {
  printf '\n%sCOMMIT BLOCKED%s  %s\n' "$red" "$off" "$1" >&2
  printf 'To do: revert with "git checkout -- ." and fix, or stage a passing change\n' >&2
  printf 'Exit WITHOUT committing until this gate is green.\n' >&2
  printf 'Skipping with --no-verify skips the only mechanical gate there is.\n\n' >&2
  exit 1
}

command -v go >/dev/null 2>&1 || fail "go not found — the gate cannot run."

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# Go packages touched (as directories), deduplicated.
# Note: stripping the `.go` extension is not enough, the DIRECTORY OF THE FILE is
# required — passing ./internal/domain/foo_test to go test eats a "setup failed" and
# the gate would block even correct code.
# And testdata/ must never enter the root scope at all: fixture modules are
# separate Go modules; ./testdata/fixtures/x is a "setup failed" for the root
# `go test` and would block every fixture PR — the easiest contribution.
pkgs=$(printf '%s\n' "$staged" | grep '\.go$' | grep -v '^testdata/' | while IFS= read -r f; do
         d=$(dirname "$f")
         [ "$d" = "." ] && d="./..." || d="./$d"
         printf '%s\n' "$d"
       done | sort -u)

# Fixture modules touched: gate them the way `make fixtures` does — build+vet
# INSIDE each module. A fixture that does not compile is still a red gate.
fx=$(printf '%s\n' "$staged" | sed -n 's|^testdata/fixtures/\([^/]*\)/.*|\1|p' | sort -u)

# Scope grows when contract files were touched.
#
# The workflow alternative must NOT be anchored with `$`: a path under
# .github/workflows/ is a FILE (ci.yml, nightly.yml), so `^\.github/workflows/$`
# matched nothing and a CI-only commit skipped the suite entirely — the one
# change where the gate earns its keep. Verified: `printf '.github/workflows/ci.yml'`
# must match here.
if printf '%s\n' "$staged" | grep -qE '^(go\.mod|go\.sum|Makefile|scripts/pre-commit)$|^\.github/workflows/'; then
  pkgs="./..."
fi

# 1) Format — only staged Go files.
gofiles=$(printf '%s\n' "$staged" | grep '\.go$' || true)
if [ -n "$gofiles" ]; then
  # shellcheck disable=SC2086
  bad=$(gofmt -l $gofiles)
  [ -n "$bad" ] && fail "gofmt: unformatted file(s): $(echo "$bad" | tr '\n' ' ')"
fi

# 2) Build and vet — repo-wide (cheap, catches independently of package scope).
go build ./... 2>&1 | tail -20 | grep . && fail "go build red."
go vet ./...   2>&1 | tail -20 | grep . && fail "go vet red."

# 3) Tests — touched packages. -count=1: cache hides flakes.
if [ -n "$pkgs" ]; then
  # shellcheck disable=SC2086
  out=$(go test -race -count=1 $pkgs 2>&1)
  if printf '%s\n' "$out" | grep -qE '^(FAIL|--- FAIL)'; then
    printf '%s\n' "$out" | grep -E '^(FAIL|--- FAIL|ok )' | head -20 >&2
    fail "go test -race red: $(printf '%s' "$pkgs" | tr '\n' ' ')"
  fi
fi

# 4) Fixture modules touched — build+vet inside each module (their own go.mod).
for name in $fx; do
  d="testdata/fixtures/$name"
  [ -f "$d/go.mod" ] || continue
  out=$(cd "$d" && go build ./... 2>&1 && go vet ./... 2>&1)
  if [ -n "$out" ]; then
    printf '%s\n' "$out" >&2
    fail "fixture module $d fails build/vet"
  fi
done

exit 0
